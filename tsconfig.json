{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
  "include": ["auth/**/*.ts", "pages/**/*.ts", "steps/**/*.ts", "tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", ".features-gen"]
}
